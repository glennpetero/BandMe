@page "/"
@inject HttpClient Http

<PageTitle>Band-Me | Find Your Group</PageTitle>

<div class="container py-4">
    <h1 class="mb-2">Find Your Band</h1>
    <p class="text-muted mb-4">Select your interests below to discover groups ranked by how well they match you.</p>

    @if (isLoading)
    {
        <p>Loading interests...</p>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">1. What are you interested in?</h5>

                @foreach (var group in allTags.GroupBy(t => t.Category))
                {
                    <div class="mb-3">
                        <strong class="d-block text-uppercase small text-secondary mb-2">@group.Key</strong>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in group)
                            {
                                bool isSelected = selectedTagIds.Contains(tag.Id);
                                <button type="button" class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => ToggleTag(tag.Id)">
                                    @(isSelected ? "✓ " : "")@tag.Name
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-success" disabled="@(selectedTagIds.Count == 0 || isSearching)"
                            @onclick="FindMatches">
                        @(isSearching ? "Matching..." : $"Find Matching Bands ({selectedTagIds.Count} selected)")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="LoadAllBands">
                        Browse All Bands
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info">@statusMessage</div>
    }

    @if (displayedBands is not null)
    {
        <h4 class="mb-3">@resultsHeading (@displayedBands.Count)</h4>

        @if (displayedBands.Count == 0)
        {
            <div class="alert alert-warning">
                No matching bands found yet. Try selecting more interests or <a href="create">create a new band</a>!
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var band in displayedBands)
                {
                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">@band.Name</h5>
                                    @if (band.MatchScore > 0)
                                    {
                                        <span class="badge bg-success fs-6">@band.MatchScore% Match</span>
                                    }
                                </div>

                                <p class="card-text text-muted flex-grow-1">@band.Description</p>

                                <div class="mb-3 d-flex flex-wrap gap-1">
                                    @foreach (var tag in band.Tags)
                                    {
                                        <span class="badge bg-light text-dark border">@tag</span>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <small class="text-muted">
                                        Members: <strong>@band.CurrentMemberCount / @band.MaxMembers</strong>
                                    </small>
                                    <button class="btn btn-sm btn-primary"
                                            disabled="@(band.CurrentMemberCount >= band.MaxMembers || joinedBandIds.Contains(band.Id))"
                                            @onclick="() => JoinBand(band)">
                                        @(joinedBandIds.Contains(band.Id) ? "Joined ✓" :
                                          band.CurrentMemberCount >= band.MaxMembers ? "Full" : "Join Band")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<InterestTag> allTags = [];
    private HashSet<int> selectedTagIds = [];
    private HashSet<int> joinedBandIds = [];
    private List<BandDto>? displayedBands;
    private string resultsHeading = "Available Bands";
    private string? statusMessage;
    private bool isLoading = true;
    private bool isSearching;

    protected override async Task OnInitializedAsync()
    {
        allTags = await Http.GetFromJsonAsync<List<InterestTag>>("api/interests") ?? [];
        await LoadAllBands();
        isLoading = false;
    }

    private void ToggleTag(int tagId)
    {
        if (!selectedTagIds.Add(tagId))
            selectedTagIds.Remove(tagId);
    }

    private async Task FindMatches()
    {
        isSearching = true;
        statusMessage = null;

        var response = await Http.PostAsJsonAsync("api/bands/match",
            new QuestionnaireSubmission { SelectedTagIds = [.. selectedTagIds] });

        if (response.IsSuccessStatusCode)
        {
            displayedBands = await response.Content.ReadFromJsonAsync<List<BandDto>>() ?? [];
            resultsHeading = "Your Top Matches";
        }

        isSearching = false;
    }

    private async Task LoadAllBands()
    {
        statusMessage = null;
        displayedBands = await Http.GetFromJsonAsync<List<BandDto>>("api/bands") ?? [];
        resultsHeading = "All Available Bands";
    }

    private async Task JoinBand(BandDto band)
    {
        var response = await Http.PostAsync($"api/bands/{band.Id}/join", null);
        if (response.IsSuccessStatusCode)
        {
            var updated = await response.Content.ReadFromJsonAsync<BandDto>();
            if (updated is not null)
                band.CurrentMemberCount = updated.CurrentMemberCount;

            joinedBandIds.Add(band.Id);
            statusMessage = $"You joined \"{band.Name}\"!";
        }
    }
}

